        },
        {
          "name": "Poll booking until PAID",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/booking/{{bookingId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "booking", "{{bookingId}}"] },
            "description": "Booking chuyển PAID bất đồng bộ (payment-service -> RabbitMQ -> booking-service). Request này tự lặp lại tối đa 20 lần cho tới khi PAID (chỉ hoạt động trong Collection Runner / Newman; nếu bấm Send lẻ thì gửi lại vài lần)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "let n = parseInt(pm.collectionVariables.get('paidPollCount') || '0', 10);",
                  "if (b.status === 'PAID') {",
                  "  pm.collectionVariables.set('paidPollCount', '0');",
                  "  pm.test('booking đã PAID', () => pm.expect(b.status).to.eql('PAID'));",
                  "} else if (n < 20) {",
                  "  pm.collectionVariables.set('paidPollCount', String(n + 1));",
                  "  console.log('Chờ PAID... lần ' + (n + 1) + ', status hiện tại = ' + b.status);",
                  "  postman.setNextRequest('Poll booking until PAID');",
                  "} else {",
                  "  pm.test('booking đã PAID', () => pm.expect(b.status, 'quá 20 lần vẫn chưa PAID — kiểm tra RabbitMQ / payment-service').to.eql('PAID'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get tickets (QR)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/booking/{{bookingId}}/tickets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "booking", "{{bookingId}}", "tickets"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const tickets = pm.response.json() || [];",
                  "pm.test('mỗi ghế 1 vé (2 vé)', () => pm.expect(tickets.length).to.eql(2));",
                  "if (tickets.length) {",
                  "  pm.collectionVariables.set('qrCode', tickets[0].qrCode);",
                  "  console.log('QR vé 1:', tickets[0].qrCode);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4 · Post-booking",
      "item": [
        {
          "name": "My bookings",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/booking/my-bookings", "host": ["{{baseUrl}}"], "path": ["api", "v1", "booking", "my-bookings"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('có booking vừa tạo', () => {",
                  "  const ids = (pm.response.json() || []).map(x => x.bookingId);",
                  "  pm.expect(ids).to.include(pm.collectionVariables.get('bookingId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "My payment transactions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payment/momo/my-transactions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payment", "momo", "my-transactions"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Check-in ticket (ADMIN)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/booking/tickets/checkin",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "booking", "tickets", "checkin"]
            },
            "body": { "mode": "raw", "raw": "{\n  \"qrCode\": \"{{qrCode}}\"\n}" },
            "description": "Cần `adminToken` từ folder 0. Soát vé lặp lại sẽ bị chặn (400)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('soát vé 200 (hoặc 400 nếu đã soát/không có adminToken)', () => {",
                  "  pm.expect([200, 400, 403]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  pm.test('vé đã đánh dấu checkedInAt', () => pm.expect(pm.response.json().checkedInAt).to.not.be.null);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel booking + auto refund",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/booking/{{bookingId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "booking", "{{bookingId}}", "cancel"]
            },
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Demo — hủy vé sau khi thanh toán\"\n}" },
            "description": "Vé đã PAID vẫn hủy được khi suất chiếu chưa bắt đầu. booking-service tự gọi payment-service hoàn tiền MoMo. Với giao dịch giả lập (TEST_TRANS_...) MoMo refund sẽ trả FAILED — đó là hành vi đúng, `refundStatus` = FAILED."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('hủy 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('trạng thái CANCELLED', () => pm.expect(b.status).to.eql('CANCELLED'));",
                  "console.log('refundStatus =', b.refundStatus);"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
