  "item": [
    {
      "name": "0 · Admin — seed data (needs ADMIN role)",
      "description": "API `POST /auth/register` luôn tạo role `USER`. Không có cách tự đăng ký ADMIN.\n\n**Cách nâng quyền ADMIN** (một lần, sau khi chạy `Register admin`):\n```\ndocker exec -i mysql-db mysql -uroot -p1234 auth_db \\\n  -e \"UPDATE users SET role='ADMIN' WHERE user_name='pmt_admin_<runId>';\"\n```\n(`<runId>` là hậu tố phiên — xem collection variable `runId` sau khi chạy request đầu.)\nRồi chạy lại `Login admin` để lấy token có quyền ADMIN.\n\nNếu đã có sẵn dữ liệu phim/suất chiếu trong DB, có thể bỏ qua cả folder này và tự set biến `showtimeId`.",
      "item": [
        {
          "name": "Register admin",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"{{adminUserName}}_{{runId}}\",\n  \"email\": \"{{adminUserName}}_{{runId}}@example.com\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('đăng ký admin (201) hoặc đã tồn tại (400)', () => {",
                  "  pm.expect([201, 400]).to.include(pm.response.code);",
                  "});",
                  "console.log('Nâng quyền:  docker exec -i mysql-db mysql -uroot -p1234 auth_db -e \"UPDATE users SET role=\\'ADMIN\\' WHERE user_name=\\'' + pm.variables.get('adminUserName') + '_' + pm.variables.get('runId') + '\\';\"');"
                ]
              }
            }
          ]
        },
        {
          "name": "Login admin",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"{{adminUserName}}_{{runId}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('adminToken', b.accessToken);",
                  "pm.test('user này có role ADMIN', () => {",
                  "  pm.expect(b.role, 'Chưa nâng quyền — chạy lệnh UPDATE users SET role=ADMIN rồi login lại').to.eql('ADMIN');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create cinema",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/catalog/cinemas", "host": ["{{baseUrl}}"], "path": ["api", "v1", "catalog", "cinemas"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"CGV Demo {{runId}}\",\n  \"address\": \"123 Nguyen Trai\",\n  \"city\": \"Ho Chi Minh\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('tạo rạp 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('cinemaId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create room (5x8, hàng D=VIP, hàng E=COUPLE)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/catalog/rooms", "host": ["{{baseUrl}}"], "path": ["api", "v1", "catalog", "rooms"] },
            "body": { "mode": "raw", "raw": "{{roomBody}}" }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const rows = 5, cols = 8;",
                  "const labels = ['A', 'B', 'C', 'D', 'E'];",
                  "const seats = [];",
                  "for (let r = 0; r < rows; r++) {",
                  "  for (let c = 0; c < cols; c++) {",
                  "    seats.push({",
                  "      rowIndex: r,",
                  "      columnIndex: c,",
                  "      rowLabel: labels[r],",
                  "      columnLabel: String(c + 1),",
                  "      seatType: r === 4 ? 'COUPLE' : (r === 3 ? 'VIP' : 'NORMAL')",
                  "    });",
                  "  }",
                  "}",
                  "pm.collectionVariables.set('roomBody', JSON.stringify({",
                  "  cinemaId: pm.collectionVariables.get('cinemaId'),",
                  "  roomName: 'Room 1',",
                  "  totalRows: rows,",
                  "  totalColumns: cols,",
                  "  seats: seats",
                  "}, null, 2));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('tạo phòng 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('roomId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create movie",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/catalog/movies", "host": ["{{baseUrl}}"], "path": ["api", "v1", "catalog", "movies"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Demo Movie {{runId}}\",\n  \"genre\": \"Action\",\n  \"country\": \"USA\",\n  \"language\": \"English\",\n  \"ageRestriction\": \"C13\",\n  \"director\": \"Jane Doe\",\n  \"actors\": \"A, B, C\",\n  \"description\": \"Phim demo cho Postman collection.\",\n  \"duration\": 120,\n  \"releaseDate\": \"{{showDate}}\",\n  \"poseUrl\": \"https://example.com/poster.jpg\",\n  \"trailerUrl\": \"https://example.com/trailer.mp4\",\n  \"status\": \"ACTIVE\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('tạo phim 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('movieId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create showtime (ngày mai 19:00)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/catalog/showtimes", "host": ["{{baseUrl}}"], "path": ["api", "v1", "catalog", "showtimes"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"movieId\": \"{{movieId}}\",\n  \"roomId\": \"{{roomId}}\",\n  \"startTime\": \"{{showtimeStart}}\",\n  \"basePrice\": 90000\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('tạo suất chiếu 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('showtimeId', pm.response.json().id);"
                ]
              }
            }
          ]
        }
      ]
    },
