    {
      "name": "2 · Browse catalog",
      "item": [
        {
          "name": "List movies (public)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/catalog/movies?pageNumber=0&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "catalog", "movies"],
              "query": [
                { "key": "pageNumber", "value": "0" },
