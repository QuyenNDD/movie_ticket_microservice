              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const content = pm.response.json().content || [];",
                  "if (!pm.collectionVariables.get('movieId') && content.length) {",
                  "  pm.collectionVariables.set('movieId', content[0].id);",
                  "  console.log('movieId auto =', content[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Showtimes for movie (by date)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/catalog/showtimes/movie/{{movieId}}?date={{showDate}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "catalog", "showtimes", "movie", "{{movieId}}"],
              "query": [{ "key": "date", "value": "{{showDate}}" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const list = pm.response.json() || [];",
                  "const scheduled = list.find(s => (s.status || '').toUpperCase() === 'SCHEDULED');",
                  "if (scheduled) {",
                  "  pm.collectionVariables.set('showtimeId', scheduled.id);",
                  "  console.log('showtimeId =', scheduled.id);",
                  "} else {",
                  "  console.warn('Không thấy suất chiếu SCHEDULED cho movieId=' + pm.collectionVariables.get('movieId') + ' ngày ' + pm.collectionVariables.get('showDate') + '. Chạy folder 0 hoặc set showtimeId thủ công.');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Seat map for showtime",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/booking/showtimes/{{showtimeId}}/seats",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "booking", "showtimes", "{{showtimeId}}", "seats"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const matrix = pm.response.json().seatMatrix || [];",
                  "const flat = matrix.flat();",
                  "const free = flat.filter(s => (s.status || '').toUpperCase() === 'AVAILABLE' && (s.type || '').toUpperCase() !== 'MAINTENANCE' && (s.type || '').toUpperCase() !== 'COUPLE');",
                  "pm.test('có ít nhất 2 ghế trống', () => pm.expect(free.length).to.be.at.least(2));",
                  "if (free.length >= 2) {",
                  "  pm.collectionVariables.set('seatId1', free[0].id);",
                  "  pm.collectionVariables.set('seatId2', free[1].id);",
                  "  console.log('Ghế chọn:', free[0].row + free[0].col, '/', free[1].row + free[1].col);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3 · Hold seats & pay",
      "item": [
        {
          "name": "Hold seats",
          "request": {
            "method": "POST",
